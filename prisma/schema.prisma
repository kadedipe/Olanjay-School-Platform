generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { ADMIN TEACHER STUDENT GUARDIAN }
enum UserStatus { INVITED ACTIVE SUSPENDED ARCHIVED }
enum EnrollmentStatus { APPLIED ENROLLED DEFERRED WITHDRAWN GRADUATED }
enum AttendanceStatus { PRESENT ABSENT LATE EXCUSED }
enum InvoiceStatus { DRAFT ISSUED PARTIALLY_PAID PAID OVERDUE VOID }
enum PaymentStatus { PENDING SUCCEEDED FAILED REFUNDED }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  firstName String
  lastName String
  phone String?
  role Role
  status UserStatus @default(INVITED)
  student Student?
  teacher Teacher?
  guardian Guardian?
  auditEvents AuditEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([role, status])
}

model Student {
  id String @id @default(cuid())
  admissionNumber String @unique
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  dateOfBirth DateTime?
  address String?
  enrollments Enrollment[]
  guardians StudentGuardian[]
  attendance Attendance[]
  results Result[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id String @id @default(cuid())
  employeeNumber String @unique
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  courses CourseTeacher[]
  timetable TimetableEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guardian {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  students StudentGuardian[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentGuardian {
  studentId String
  guardianId String
  relationship String
  isPrimary Boolean @default(false)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  @@id([studentId, guardianId])
}

model AcademicYear {
  id String @id @default(cuid())
  name String @unique
  startsAt DateTime
  endsAt DateTime
  isCurrent Boolean @default(false)
  terms Term[]
  enrollments Enrollment[]
  createdAt DateTime @default(now())
}

model Term {
  id String @id @default(cuid())
  name String
  startsAt DateTime
  endsAt DateTime
  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  attendance Attendance[]
  assessments Assessment[]
  invoices Invoice[]
  @@unique([academicYearId, name])
}

model Course {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  qualification String
  durationMonths Int
  isActive Boolean @default(true)
  enrollments Enrollment[]
  teachers CourseTeacher[]
  timetable TimetableEntry[]
  assessments Assessment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseTeacher {
  courseId String
  teacherId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@id([courseId, teacherId])
}

model Enrollment {
  id String @id @default(cuid())
  studentId String
  courseId String
  academicYearId String
  yearLevel Int
  status EnrollmentStatus @default(APPLIED)
  enrolledAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  @@unique([studentId, courseId, academicYearId])
  @@index([courseId, academicYearId, status])
}

model TimetableEntry {
  id String @id @default(cuid())
  courseId String
  teacherId String
  weekday Int
  startsAt String
  endsAt String
  room String
  course Course @relation(fields: [courseId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  attendance Attendance[]
  @@index([weekday, startsAt])
}

model Attendance {
  id String @id @default(cuid())
  studentId String
  timetableEntryId String
  termId String
  attendanceDate DateTime @db.Date
  status AttendanceStatus
  note String?
  student Student @relation(fields: [studentId], references: [id])
  timetableEntry TimetableEntry @relation(fields: [timetableEntryId], references: [id])
  term Term @relation(fields: [termId], references: [id])
  @@unique([studentId, timetableEntryId, attendanceDate])
}

model Assessment {
  id String @id @default(cuid())
  courseId String
  termId String
  title String
  type String
  maximumScore Decimal @db.Decimal(6,2)
  weight Decimal @db.Decimal(5,2)
  dueAt DateTime?
  course Course @relation(fields: [courseId], references: [id])
  term Term @relation(fields: [termId], references: [id])
  results Result[]
  @@index([courseId, termId])
}

model Result {
  id String @id @default(cuid())
  assessmentId String
  studentId String
  score Decimal @db.Decimal(6,2)
  grade String?
  feedback String?
  publishedAt DateTime?
  assessment Assessment @relation(fields: [assessmentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  @@unique([assessmentId, studentId])
}

model Invoice {
  id String @id @default(cuid())
  number String @unique
  studentId String
  termId String
  amount Decimal @db.Decimal(12,2)
  currency String @default("UGX")
  dueAt DateTime
  status InvoiceStatus @default(DRAFT)
  student Student @relation(fields: [studentId], references: [id])
  term Term @relation(fields: [termId], references: [id])
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([studentId, status])
}

model Payment {
  id String @id @default(cuid())
  invoiceId String
  reference String @unique
  amount Decimal @db.Decimal(12,2)
  provider String
  status PaymentStatus @default(PENDING)
  paidAt DateTime?
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  createdAt DateTime @default(now())
}

model AuditEvent {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  ipAddress String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}
